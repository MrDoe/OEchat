{
  "name": "oechat",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test": "npm run test -w server",
    "sync-dict": "tsx scripts/sync-dict.ts",
    "check-tts": "tsx scripts/check-tts.ts",
    "check-pronunciation": "tsx scripts/check-pronunciation.mts"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}